# RMAgent Environment Configuration
#
# Copy this file to config/.env and fill in your values
# See docs/USER_GUIDE.md for setup instructions

# ============================================================================
# LLM Provider Configuration
# ============================================================================

# Primary LLM provider (anthropic, openai, ollama)
DEFAULT_LLM_PROVIDER=anthropic

# Anthropic API Key (for Claude models)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# OpenAI API Key (optional)
# OPENAI_API_KEY=sk-xxxxx

# Ollama Configuration (optional)
# OLLAMA_BASE_URL=http://localhost:11434

# ============================================================================
# RootsMagic Database
# ============================================================================

# Path to RootsMagic 11 database file (.rmtree)
RM_DATABASE_PATH=data/Iiams.rmtree

# ============================================================================
# Census Extraction Configuration (New - PostgreSQL)
# ============================================================================

# PostgreSQL connection string for census sidecar database
# Format: postgresql://user:password@host:port/database
#
# For Docker Compose (default):
CENSUS_DB_URL=postgresql://rmagent:census_dev_password@localhost:5432/census_sidecar

# For production PostgreSQL:
# CENSUS_DB_URL=postgresql://rmagent:SECURE_PASSWORD@db.example.com:5432/census_sidecar

# PostgreSQL password (used by Docker Compose)
# Change this for production deployments!
CENSUS_DB_PASSWORD=census_dev_password

# Optional: pgAdmin password (if using pgAdmin container)
# PGADMIN_PASSWORD=admin

# ============================================================================
# Logging
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# DEBUG enables LLM request/response logging to logs/llm_debug.jsonl
LOG_LEVEL=INFO

# ============================================================================
# Export Paths
# ============================================================================

# Output directory for generated biographies
# BIOGRAPHY_OUTPUT_DIR=reports/biographies

# Output directory for Hugo export
# HUGO_EXPORT_DIR=hugo-site/content/people
