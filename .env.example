# RMTool Configuration
# Copy this file to .env and fill in your values

# LLM Provider Settings
# Options: anthropic, openai, ollama
DEFAULT_LLM_PROVIDER=anthropic

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-3-5-sonnet-20250110

# OpenAI (GPT-4)
OPENAI_API_KEY=sk-xxxxx
OPENAI_MODEL=gpt-4-turbo-preview

# Ollama (local models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Database
RM_DATABASE_PATH=data/Iiams.rmtree

# SQLite Extension
SQLITE_ICU_EXTENSION=./sqlite-extension/icu.dylib

# Output Settings
OUTPUT_DIR=output
EXPORT_DIR=exports

# Privacy Settings
RESPECT_PRIVATE_FLAG=true
APPLY_110_YEAR_RULE=true

# Citation Style
# Options: footnote, parenthetical, narrative
DEFAULT_CITATION_STYLE=footnote

# Logging
LOG_LEVEL=INFO
LOG_FILE=rmtool.log
