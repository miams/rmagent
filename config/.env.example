# RMAgent Configuration
# Copy this file to .env and fill in your values

# LLM Provider Settings
# Options: anthropic, openai, ollama
DEFAULT_LLM_PROVIDER=anthropic
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-3-5-sonnet-20250110

# OpenAI (GPT-4)
OPENAI_API_KEY=sk-xxxxx
OPENAI_MODEL=gpt-4-turbo-preview

# Ollama (local models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Database
RM_DATABASE_PATH=data/Iiams.rmtree

# SQLite Extension
SQLITE_ICU_EXTENSION=./sqlite-extension/icu.dylib

# Output Settings
OUTPUT_DIR=output
EXPORT_DIR=exports

# Privacy Settings
RESPECT_PRIVATE_FLAG=true
APPLY_110_YEAR_RULE=true

# Citation Style
# Options: footnote, parenthetical, narrative
DEFAULT_CITATION_STYLE=footnote

# Search Settings
# Surname variations for [ALL] keyword (comma-separated)
SURNAME_VARIANTS_ALL=Iams,Iames,Iiams,Iiames,Ijams,Ijames,Imes,Eimes

# Logging
LOG_LEVEL=INFO
LOG_FILE=rmagent.log
LLM_DEBUG_LOG_FILE=logs/llm_debug.jsonl
